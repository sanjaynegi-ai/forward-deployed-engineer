# Copy this file to .env (never commit .env -- .gitignore already excludes it) and fill
# in only the keys the session you're running actually needs. Every session's optional
# "live model" cell calls python-dotenv's load_dotenv(), which walks up the directory
# tree from wherever the notebook lives and finds this file at the repo root
# automatically -- no per-session copy needed, no shell export required.

# Used by S00, S02, S04, and S05's optional live-model cells, and S01's optional
# Part 6 (an OpenAI-compatible endpoint, here via OpenRouter).
OPENROUTER_API_KEY=replace_me

# Used only by S03's optional Section 8b hosted-provider comparison, and S01's optional
# Part 6 if you point it at OpenAI directly instead of OpenRouter.
OPENAI_API_KEY=replace_me
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=openrouter/free

# S01's and S06's standalone CLI apps (sessions/*/lab/main.py) each have their own
# .env.example for when that folder is used on its own, outside this repo -- but their
# load_dotenv() calls also fall back to this root .env if no local one exists.
